<Window x:Class="GlyphEcho.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430" Height="230" MinWidth="380" MinHeight="210"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Transparent" SourceInitialized="Window_SourceInitialized">
    <Border x:Name="RootSurface" Background="{StaticResource SurfaceBrush}" Padding="24" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Width="38" Height="38" Background="#18147D76" CornerRadius="6"><Image Source="{StaticResource GlyphEchoLogo}" Width="25" Height="25"/></Border>
            </Grid>
            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,18,0,18" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="21"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource SecondaryButtonStyle}" MinWidth="76" Height="34" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="AcceptButton" Content="确定" Style="{StaticResource CommandButtonStyle}" MinWidth="76" Height="34" Click="Accept_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
