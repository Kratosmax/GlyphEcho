<Window x:Class="GlyphEcho.RuleEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="编辑应用规则" Width="760" Height="650" Background="#F4F7F8" WindowStartupLocation="CenterOwner">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="编辑应用规则" FontSize="22" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="目标使用绝对路径匹配；引用通用目录后可逐项修改，未修改项继承默认规则" Foreground="#626A70" Margin="0,7,0,18"/>
  <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="36"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="规则名称" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Grid.Column="1" Padding="8" Height="34"/><TextBlock Grid.Row="1" Text="进程搜索" VerticalAlignment="Center"/><TextBox x:Name="ProcessSearchBox" Grid.Row="1" Grid.Column="1" Padding="8" Height="34" TextChanged="ProcessSearch_TextChanged" ToolTip="按进程名或完整路径搜索"/><TextBlock Grid.Row="2" Text="目标进程" VerticalAlignment="Center"/><ComboBox x:Name="ProcessSelect" Grid.Row="2" Grid.Column="1" Height="34" Padding="6"/><TextBlock Grid.Row="3" Text="匹配优先级" VerticalAlignment="Center"/><ComboBox x:Name="PriorityBox" Grid.Row="3" Grid.Column="1" Height="34" Padding="6"><ComboBoxItem Content="0 · 普通"/><ComboBoxItem Content="1 · 优先"/><ComboBoxItem Content="2 · 最高"/></ComboBox></Grid>
  <Border Grid.Row="3" Background="#FAFCFC" BorderBrush="#CBD3D6" BorderThickness="1" Padding="16" Margin="0,18,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><WrapPanel><CheckBox x:Name="EnabledBox" Content="启用规则" Margin="0,0,18,0"/><CheckBox x:Name="SingleBox" Content="允许单个按键" Margin="0,0,18,0"/><CheckBox x:Name="UseGlobalCatalogBox" Content="引用通用按键目录" Margin="0,0,18,0"/><ComboBox x:Name="LevelBox" Width="160"><ComboBoxItem Content="低 · 单个按键"/><ComboBoxItem Content="中 · 组合键"/><ComboBoxItem Content="高 · 来源与功能"/></ComboBox></WrapPanel><TextBox x:Name="DescriptionBox" Padding="8" Margin="0,12,0,10" ToolTip="功能说明，可留空"/><TextBlock Text="按键目录" FontWeight="SemiBold"/><TextBlock Text="点击下方按钮后再按键；每行的开关控制是否展示" Foreground="#626A70" FontSize="11"/></StackPanel><ListBox Grid.Row="1" x:Name="KeysList" Margin="0,10,0,0" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="0,3"><CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center"/><TextBlock Text="{Binding Key}" Margin="8,0"/><TextBlock Text="{Binding Description}" Foreground="#626A70"/><Button Content="删除" DockPanel.Dock="Right" Height="28" Padding="9,0" Click="DeleteKey_Click"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="取消" Padding="14,8" Margin="0,0,8,0" Click="Cancel_Click"/><Button Content="保存规则" Style="{StaticResource PrimaryButton}" Padding="14,8" Click="Save_Click"/></StackPanel>
 </Grid>
</Window>
