<Window x:Class="GlyphEcho.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑应用规则" Width="780" Height="680" MinWidth="680" MinHeight="590"
        Background="Transparent" WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized">
    <Border x:Name="RootSurface" Background="{StaticResource SurfaceBrush}" Padding="28,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="编辑应用规则" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="按进程完整路径匹配；应用规则可以继承通用按键目录" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Width="42" Height="42" Background="#18147D76" CornerRadius="6">
                    <TextBlock Text="&#xE8D4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <Grid Grid.Row="1" Margin="0,22,0,0">
                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="规则名称" VerticalAlignment="Center"/><TextBox x:Name="NameBox" Grid.Column="1"/>
                <TextBlock Grid.Row="1" Text="进程搜索" VerticalAlignment="Center"/><TextBox x:Name="ProcessSearchBox" Grid.Row="1" Grid.Column="1" TextChanged="ProcessSearch_TextChanged" ToolTip="按进程名或完整路径搜索"/>
                <TextBlock Grid.Row="2" Text="目标进程" VerticalAlignment="Center"/><ComboBox x:Name="ProcessSelect" Grid.Row="2" Grid.Column="1"/>
                <TextBlock Grid.Row="3" Text="匹配优先级" VerticalAlignment="Center"/><ComboBox x:Name="PriorityBox" Grid.Row="3" Grid.Column="1"><ComboBoxItem Content="0 · 普通"/><ComboBoxItem Content="1 · 优先"/><ComboBoxItem Content="2 · 最高"/></ComboBox>
            </Grid>
            <Border Grid.Row="2" Height="1" Margin="0,18,0,16" Background="#D7DEE0"/>
            <Grid Grid.Row="3">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <WrapPanel>
                    <CheckBox x:Name="EnabledBox" Content="启用规则" Margin="0,0,18,0"/>
                    <CheckBox x:Name="SingleBox" Content="允许单个按键" Margin="0,0,18,0"/>
                    <CheckBox x:Name="UseGlobalCatalogBox" Content="引用通用按键目录" Margin="0,0,18,0" Checked="CatalogMode_Changed" Unchecked="CatalogMode_Changed"/>
                    <ComboBox x:Name="LevelBox" Width="160"><ComboBoxItem Content="低 · 单个按键"/><ComboBoxItem Content="中 · 组合键"/><ComboBoxItem Content="高 · 来源与功能"/></ComboBox>
                </WrapPanel>
                <TextBox x:Name="DescriptionBox" Grid.Row="1" Margin="0,12,0,14" ToolTip="功能说明，可留空"/>
                <StackPanel Grid.Row="2" Margin="0,0,0,9"><TextBlock Text="按键目录" FontWeight="SemiBold"/><TextBlock Text="开关决定是否展示；继承项删除后会在当前规则中禁用" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                <ListBox Grid.Row="3" x:Name="KeysList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#B8FFFFFF" BorderBrush="#D7DEE0" BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,0,0,6">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Key}" Margin="10,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Description}"/>
                                    <Button Grid.Column="3" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource DangerBrush}" Style="{StaticResource IconButtonStyle}" Click="DeleteKey_Click" ToolTip="删除或禁用"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" MinWidth="78" Height="34" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="保存规则" Style="{StaticResource CommandButtonStyle}" MinWidth="96" Height="34" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
