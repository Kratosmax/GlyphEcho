<Window x:Class="GlyphEcho.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" MinWidth="120" MaxWidth="520"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border x:Name="Surface" Background="#F2182529" BorderBrush="#8061D2C6"
            BorderThickness="1" CornerRadius="8" Padding="10,9">
        <StackPanel x:Name="QueueRows" />
    </Border>
</Window>
