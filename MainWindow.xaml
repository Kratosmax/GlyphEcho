<Window x:Class="GlyphEcho.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GlyphEcho 0.2.0" Width="1100" Height="720" MinWidth="900" MinHeight="620" Background="#F3F6F5">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#17201D"><Grid Margin="16,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Border Width="34" Height="34" Background="#2BB58B" CornerRadius="6"><TextBlock Text="⌨" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="GlyphEcho" Foreground="White" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="按键展示工具" Foreground="#91A49B" FontSize="11"/></StackPanel></StackPanel><StackPanel Grid.Row="2"><Button Content="概览" Tag="Default" Click="Navigate_Click" Height="42" Margin="0,0,0,6" Foreground="White" Background="#2B3733" BorderBrush="#2B3733" HorizontalContentAlignment="Left" Padding="12,0"/><Button Content="应用规则" Tag="Rules" Click="Navigate_Click" Height="42" Margin="0,0,0,6" Foreground="#D6DFDB" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="12,0"/><Button Content="按键目录" Tag="Keys" Click="Navigate_Click" Height="42" Foreground="#D6DFDB" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="12,0"/></StackPanel><StackPanel Grid.Row="3"><Separator Background="#35433E" Margin="0,0,0,12"/><TextBlock x:Name="SidebarStatusText" Text="后台监听已启用" Foreground="#7F928A" FontSize="11" Margin="12,0,0,0"/><TextBlock Text="0.2.0" Foreground="#7F928A" FontSize="11" Margin="12,8,0,0"/></StackPanel></Grid></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
   <Grid Margin="30,26,30,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="按键展示规则" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="全局监听 · 规则按前台进程绝对路径匹配" Foreground="#66736E" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Content="保存设置" Style="{StaticResource PrimaryButton}" Width="120" Height="36" Click="Save_Click"/></Grid>
    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D9E0DD" BorderThickness="1" Padding="14" Margin="0,22,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="展示级别" Foreground="#66736E" VerticalAlignment="Center" Margin="0,0,12,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><RadioButton x:Name="Low" Content="低 · 单键" Margin="0,0,20,0"/><RadioButton x:Name="Medium" Content="中 · 组合键" Margin="0,0,20,0"/><RadioButton x:Name="High" Content="高 · 来源与功能"/></StackPanel><TextBlock Grid.Column="2" Text="● 监听中" Foreground="#167A5B" VerticalAlignment="Center" FontWeight="SemiBold"/></Grid></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.45*"/></Grid.ColumnDefinitions>
     <Border x:Name="DefaultPanel" Background="#FFFFFF" BorderBrush="#D9E0DD" BorderThickness="1" Padding="20"><StackPanel><TextBlock Text="默认规则" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="所有没有专属规则的应用使用这里" Foreground="#66736E" Margin="0,6,0,16"/><CheckBox x:Name="DefaultEnabled" Content="启用默认规则" Margin="0,0,0,8"/><CheckBox x:Name="DefaultSingle" Content="允许单个按键显示" Margin="0,0,0,14"/><TextBlock Text="模式" Foreground="#66736E"/><ComboBox x:Name="ModeSelect" Margin="0,6,0,14"><ComboBoxItem Content="普通模式"/><ComboBoxItem Content="游戏模式"/><ComboBoxItem Content="演示模式"/></ComboBox><TextBlock Text="展示位置" Foreground="#66736E"/><StackPanel Orientation="Horizontal" Margin="0,6,0,14"><ComboBox x:Name="PositionSelect" Width="92"><ComboBoxItem Content="右下"/><ComboBoxItem Content="右上"/><ComboBoxItem Content="左下"/><ComboBoxItem Content="左上"/></ComboBox><ComboBox x:Name="MonitorSelect" Width="142" Margin="8,0,0,0"/></StackPanel><TextBlock Text="关闭窗口时" Foreground="#66736E"/><ComboBox x:Name="CloseBehavior" Margin="0,6,0,12"><ComboBoxItem Content="缩小到托盘（继续监听）"/><ComboBoxItem Content="退出程序（停止监听）"/></ComboBox><TextBlock Text="界面主题" Foreground="#66736E"/><ComboBox x:Name="ThemeSelect" Margin="0,6,0,12"><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/><ComboBoxItem Content="跟随系统"/></ComboBox><StackPanel Orientation="Horizontal"><Button Content="预览展示" Height="34" Padding="14,0" Click="Preview_Click"/></StackPanel><TextBlock Text="在编辑器中按实际键盘录入并管理目录" FontSize="11" Foreground="#66736E" Margin="0,7,0,0"/></StackPanel></Border>
     <Border x:Name="RulesPanel" Grid.Column="2" Background="#FFFFFF" BorderBrush="#D9E0DD" BorderThickness="1" Padding="20"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="应用规则" FontSize="18" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="添加规则" Style="{StaticResource PrimaryButton}" Height="34" Click="AddRule_Click"/><Button x:Name="DuplicateRuleButton" Content="&#xE8C8;" Style="{StaticResource IconButton}" Margin="6,0,0,0" Click="DuplicateRule_Click" ToolTip="复制选中规则"/><Button x:Name="EditRuleButton" Content="&#xE70F;" Style="{StaticResource IconButton}" Margin="2,0,0,0" Click="EditRule_Click" ToolTip="编辑选中规则"/><Button x:Name="DeleteRuleButton" Content="&#xE74D;" Style="{StaticResource IconButton}" Margin="2,0,0,0" Click="DeleteRule_Click" ToolTip="删除选中规则"/></StackPanel></Grid><TextBlock Text="优先级高的规则优先匹配；路径重复时按优先级生效" Foreground="#66736E" Margin="0,6,0,12"/><ListBox x:Name="RulesList" Height="320" SelectionChanged="RulesList_SelectionChanged" MouseDoubleClick="EditRule_Click"><ListBox.ItemTemplate><DataTemplate><Border Background="#F7F9F8" BorderBrush="#D9E0DD" BorderThickness="1" Padding="12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding ProcessPath}" Foreground="#66736E" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessPath}"/><TextBlock Foreground="#167A5B" FontSize="11"><Run Text="按键目录："/><Run Text="{Binding KeyRules.Count, Mode=OneWay}"/><Run Text=" 项 · 优先级 " /><Run Text="{Binding Priority}"/></TextBlock></StackPanel><TextBlock Grid.Column="1" Text="{Binding Level, StringFormat=级别 {0}}" Foreground="#167A5B"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
    </Grid>
    <Border x:Name="CatalogPanel" Grid.Row="2" Background="#FFFFFF" BorderBrush="#D9E0DD" BorderThickness="1" Padding="20" Visibility="Collapsed"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="按键目录" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="所有监听到的组合快捷键都会自动记录在这里" Foreground="#66736E" Margin="0,6,0,0"/></StackPanel><CheckBox x:Name="CatalogDefaultEnabled" Grid.Column="1" Content="新按键默认允许" VerticalAlignment="Center" Checked="CatalogDefaultEnabled_Changed" Unchecked="CatalogDefaultEnabled_Changed"/></Grid><TextBox x:Name="CatalogSearchBox" Grid.Row="1" Height="34" Padding="8" Margin="0,18,0,12" TextChanged="CatalogSearch_TextChanged" ToolTip="搜索按键，例如 Ctrl + C"/><ListBox x:Name="CatalogList" Grid.Row="2" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><DockPanel Margin="0,3" LastChildFill="False"><CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center"/><TextBlock Text="{Binding Key}" FontSize="15" Margin="10,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Description}" Foreground="#66736E" VerticalAlignment="Center"/><Button Content="删除" DockPanel.Dock="Right" Width="56" Height="28" Padding="0" Click="DeleteCatalogKey_Click"/></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
   </Grid>
   <Border Grid.Row="1" Background="#E8EEEB" BorderBrush="#D9E0DD" BorderThickness="0,1,0,0"><Grid Margin="30,0"><TextBlock Text="就绪" Foreground="#66736E" VerticalAlignment="Center"/><TextBlock x:Name="ListenerStatusText" Text="监听中" Foreground="#167A5B" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
