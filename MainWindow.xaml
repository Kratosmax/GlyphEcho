<Window x:Class="GlyphEcho.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="GlyphEcho" Width="1120" Height="740" MinWidth="920" MinHeight="640" Background="Transparent" SourceInitialized="Window_SourceInitialized">
    <Window.Resources><x:Array x:Key="PriorityValues" Type="{x:Type sys:Int32}"><sys:Int32>0</sys:Int32><sys:Int32>1</sys:Int32><sys:Int32>2</sys:Int32><sys:Int32>3</sys:Int32><sys:Int32>4</sys:Int32><sys:Int32>5</sys:Int32><sys:Int32>6</sys:Int32><sys:Int32>7</sys:Int32><sys:Int32>8</sys:Int32><sys:Int32>9</sys:Int32><sys:Int32>10</sys:Int32></x:Array></Window.Resources>
    <Border x:Name="RootSurface" Background="{StaticResource SurfaceBrush}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#B8FFFFFF" BorderBrush="#D7DEE0" BorderThickness="0,0,1,0"><Grid Margin="16,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="26"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal"><Border Width="36" Height="36" Background="#18147D76" CornerRadius="6"><Image Source="{StaticResource GlyphEchoLogo}" Width="25" Height="25"/></Border><StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="GlyphEcho" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="输入回显" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/></StackPanel></StackPanel>
                <StackPanel Grid.Row="2"><Button Tag="Default" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Width="24" FontFamily="Segoe MDL2 Assets" Text="&#xE80F;"/><TextBlock Text="概览"/></StackPanel></Button><Button Tag="Rules" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Width="24" FontFamily="Segoe MDL2 Assets" Text="&#xE8D4;"/><TextBlock Text="应用规则"/></StackPanel></Button><Button Tag="Keys" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Width="24" FontFamily="Segoe MDL2 Assets" Text="&#xE765;"/><TextBlock Text="按键目录"/></StackPanel></Button><Button Tag="Network" Style="{StaticResource NavButtonStyle}" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Width="24" FontFamily="Segoe MDL2 Assets" Text="&#xE774;"/><TextBlock Text="网络与更新"/></StackPanel></Button></StackPanel>
                <StackPanel Grid.Row="3"><Border Height="1" Background="#D7DEE0" Margin="0,0,0,12"/><TextBlock x:Name="SidebarStatusText" Text="后台监听已启用" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="12,0"/><TextBlock x:Name="SidebarVersionText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="12,8,0,0"/></StackPanel>
            </Grid></Border>
            <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
                <Grid Margin="30,26,30,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="按键展示规则" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="全局监听 · 规则按前台进程绝对路径匹配" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/></StackPanel><Button x:Name="SaveButton" Grid.Column="1" Content="保存设置" Style="{StaticResource CommandButtonStyle}" Width="112" Height="36" Click="Save_Click"/></Grid>
                    <Grid x:Name="OverviewPanel" Grid.Row="1" Margin="0,22,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="#AFFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="展示级别" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/><StackPanel x:Name="LevelOptionsPanel" Grid.Column="1" Orientation="Horizontal"><RadioButton x:Name="Low" Content="低 · 单键" Margin="0,0,20,0"/><RadioButton x:Name="Medium" Content="中 · 组合键" Margin="0,0,20,0"/><RadioButton x:Name="High" Content="高 · 来源与功能" ToolTipService.ShowOnDisabled="True"/></StackPanel><TextBlock Grid.Column="2" x:Name="TopListenerStatus" Text="● 监听中" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/></Grid></Border>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.45*"/></Grid.ColumnDefinitions>
                            <Border x:Name="DefaultPanel" Background="#AFFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0"><TextBlock Text="默认规则" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="未匹配专属规则的应用使用这里" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,16"/><CheckBox x:Name="DefaultEnabled" Content="启用默认规则" Height="32"/><CheckBox x:Name="DefaultSingle" Content="允许单个按键显示" Height="32" ToolTipService.ShowOnDisabled="True"/><TextBlock Text="模式" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,6"/><ComboBox x:Name="ModeSelect" SelectionChanged="ModeSelect_SelectionChanged" ToolTipService.ShowDuration="20000"><ComboBoxItem Content="普通模式" ToolTip="遵循默认规则和应用规则的单键、展示级别设置。"/><ComboBoxItem Content="游戏模式" ToolTip="强制显示单键，可选择低级或中级提示。"/><ComboBoxItem Content="演示模式" ToolTip="强制显示单键，并展示按键来源和功能说明。"/></ComboBox><TextBlock x:Name="ModeDescriptionText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0"/><TextBlock Text="展示位置" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="PositionSelect" SelectionChanged="PositionSelect_SelectionChanged"><ComboBoxItem Content="右下"/><ComboBoxItem Content="右上"/><ComboBoxItem Content="左下"/><ComboBoxItem Content="左上"/></ComboBox><ComboBox x:Name="MonitorSelect" Grid.Column="1" Margin="8,0,0,0"/></Grid><TextBlock Text="位置微调（像素）" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,6" ToolTip="X 正数向右，Y 正数向下；每个展示位置独立保存。"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="58"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="OffsetXBox" Grid.Column="1" ToolTip="正数向右，负数向左"/><TextBlock Grid.Column="3" Text="Y" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="OffsetYBox" Grid.Column="4" ToolTip="正数向下，负数向上"/></Grid><Button Content="重置当前位置" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ResetPositionOffset_Click" ToolTip="将当前展示位置的 X/Y 微调恢复为 0"/><TextBlock Text="提示色板" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,2"/><TextBlock Text="选择深浅样式和重复次数文字颜色" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/><Grid Margin="0,7,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="36"/></Grid.RowDefinitions><TextBlock Text="深色" VerticalAlignment="Center"/><RadioButton x:Name="PaletteDarkMint" Grid.Column="1" GroupName="OverlayPalette" Tag="dark-mint" Margin="0,0,10,0" Checked="OverlayPalette_Changed" ToolTip="深色 · 薄荷绿"><Border Width="54" Height="28" Background="#182529" BorderBrush="#4C6F71" BorderThickness="1" CornerRadius="4"><TextBlock Text="×1" Foreground="#61D2C6" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></RadioButton><RadioButton x:Name="PaletteDarkBlue" Grid.Column="2" GroupName="OverlayPalette" Tag="dark-blue" Margin="0,0,10,0" Checked="OverlayPalette_Changed" ToolTip="深色 · 天空蓝"><Border Width="54" Height="28" Background="#182529" BorderBrush="#4C6F71" BorderThickness="1" CornerRadius="4"><TextBlock Text="×2" Foreground="#82B7FF" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></RadioButton><RadioButton x:Name="PaletteDarkAmber" Grid.Column="3" GroupName="OverlayPalette" Tag="dark-amber" Checked="OverlayPalette_Changed" ToolTip="深色 · 琥珀黄"><Border Width="54" Height="28" Background="#182529" BorderBrush="#4C6F71" BorderThickness="1" CornerRadius="4"><TextBlock Text="×3" Foreground="#FFD166" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></RadioButton><TextBlock Grid.Row="1" Text="浅色" VerticalAlignment="Center"/><RadioButton x:Name="PaletteLightTeal" Grid.Row="1" Grid.Column="1" GroupName="OverlayPalette" Tag="light-teal" Margin="0,0,10,0" Checked="OverlayPalette_Changed" ToolTip="浅色 · 深青"><Border Width="54" Height="28" Background="#F8FAFA" BorderBrush="#C6D0D3" BorderThickness="1" CornerRadius="4"><TextBlock Text="×1" Foreground="#0F766E" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></RadioButton><RadioButton x:Name="PaletteLightBlue" Grid.Row="1" Grid.Column="2" GroupName="OverlayPalette" Tag="light-blue" Margin="0,0,10,0" Checked="OverlayPalette_Changed" ToolTip="浅色 · 钴蓝"><Border Width="54" Height="28" Background="#F8FAFA" BorderBrush="#C6D0D3" BorderThickness="1" CornerRadius="4"><TextBlock Text="×2" Foreground="#1D4ED8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></RadioButton><RadioButton x:Name="PaletteLightRose" Grid.Row="1" Grid.Column="3" GroupName="OverlayPalette" Tag="light-rose" Checked="OverlayPalette_Changed" ToolTip="浅色 · 玫红"><Border Width="54" Height="28" Background="#F8FAFA" BorderBrush="#C6D0D3" BorderThickness="1" CornerRadius="4"><TextBlock Text="×3" Foreground="#BE185D" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></RadioButton></Grid><CheckBox x:Name="StartWithWindowsCheck" Content="登录 Windows 后自动在后台启动" Height="36" Margin="0,10,0,0"/><TextBlock Text="关闭窗口时" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,6"/><ComboBox x:Name="CloseBehavior"><ComboBoxItem Content="缩小到托盘（继续监听）"/><ComboBoxItem Content="退出程序（停止监听）"/></ComboBox><CheckBox x:Name="MaterialCheck" Content="使用 Windows 11 系统毛玻璃材质" Height="38" Margin="0,10,0,0"/><Button Content="预览队列" Style="{StaticResource SecondaryButtonStyle}" Height="34" HorizontalAlignment="Left" Click="Preview_Click"/><TextBlock Text="飞智背键可在空间站映射 F13-F16，对应显示 M1-M4" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></ScrollViewer></Border>
                            <Border x:Name="RulesPanel" Grid.Column="2" Background="#AFFFFFFF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="应用规则" FontSize="18" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="添加规则" Style="{StaticResource CommandButtonStyle}" Height="34" Click="AddRule_Click"/><Button x:Name="DuplicateRuleButton" Content="&#xE8C8;" Style="{StaticResource IconButtonStyle}" Margin="6,0,0,0" Click="DuplicateRule_Click" ToolTip="复制选中规则"/><Button x:Name="EditRuleButton" Content="&#xE70F;" Style="{StaticResource IconButtonStyle}" Click="EditRule_Click" ToolTip="编辑选中规则"/><Button x:Name="DeleteRuleButton" Content="&#xE74D;" Foreground="{StaticResource DangerBrush}" Style="{StaticResource IconButtonStyle}" Click="DeleteRule_Click" ToolTip="删除选中规则"/></StackPanel></Grid><TextBlock Grid.Row="1" Text="优先级高的规则先匹配；路径重复时按优先级生效" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,12"/><ListBox Grid.Row="2" x:Name="RulesList" BorderThickness="0" Background="Transparent" SelectionChanged="RulesList_SelectionChanged" MouseDoubleClick="EditRule_Click"><ListBox.ItemTemplate><DataTemplate><Border Background="#B8FFFFFF" BorderBrush="#D7DEE0" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding ProcessPath}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProcessPath}"/><TextBlock Foreground="{StaticResource PrimaryBrush}" FontSize="11"><Run Text="按键目录："/><Run Text="{Binding KeyRules.Count, Mode=OneWay}"/><Run Text=" 项 · 优先级 "/><Run Text="{Binding Priority}"/></TextBlock></StackPanel><TextBlock Grid.Column="1" Text="{Binding Level, StringFormat=级别 {0}}" Foreground="{StaticResource PrimaryBrush}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
                        </Grid>
                    </Grid>
                    <Grid x:Name="CatalogPanel" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="所有监听到的组合快捷键" Foreground="{StaticResource TextSecondaryBrush}"/><CheckBox x:Name="CatalogDefaultEnabled" Grid.Column="1" Content="新按键默认允许" Checked="CatalogDefaultEnabled_Changed" Unchecked="CatalogDefaultEnabled_Changed"/></Grid><TextBox x:Name="CatalogSearchBox" Grid.Row="1" Margin="0,14,0,10" TextChanged="CatalogSearch_TextChanged" ToolTip="搜索按键，例如 Ctrl + C"/><Grid Grid.Row="2" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CatalogSelectionText" Text="已选 0 项" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="全选结果" Style="{StaticResource SecondaryButtonStyle}" Height="32" Margin="0,0,8,0" Click="SelectAllCatalog_Click" ToolTip="选择当前搜索结果"/><Button x:Name="DeleteSelectedCatalogButton" Grid.Column="2" Content="删除所选" Style="{StaticResource SecondaryButtonStyle}" Foreground="{StaticResource DangerBrush}" Height="32" IsEnabled="False" Click="DeleteSelectedCatalog_Click"/></Grid><ListBox x:Name="CatalogList" Grid.Row="3" BorderThickness="0" Background="Transparent" SelectionMode="Extended" SelectionChanged="CatalogList_SelectionChanged"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,0,0,6"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#B8FFFFFF"/><Setter Property="BorderBrush" Value="#D7DEE0"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Background" Value="#D7EDEA"/><Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><DockPanel LastChildFill="False"><CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Click="CatalogKeyEnabled_Click" ToolTip="是否允许展示"/><TextBlock Text="{Binding Key}" FontSize="15" Margin="10,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/><Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource DangerBrush}" Style="{StaticResource IconButtonStyle}" DockPanel.Dock="Right" Click="DeleteCatalogKey_Click" ToolTip="删除"/></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
                    <Grid x:Name="NetworkPanel" Grid.Row="1" Margin="0,22,0,0" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,12"><TextBlock Text="更新通道" FontSize="16" FontWeight="SemiBold"/><ComboBox x:Name="UpdateChannelSelect" Width="250" HorizontalAlignment="Left" Margin="14,10,0,0"><ComboBoxItem Content="Lite · 需要 .NET 运行时" Tag="lite"/><ComboBoxItem Content="Full · 自包含运行时" Tag="full"/></ComboBox><Border Height="1" Margin="0,22" Background="#D7DEE0"/><Grid><TextBlock Text="GitHub 访问线路" FontSize="16" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="&#xE710;" Style="{StaticResource IconButtonStyle}" Click="AddProxy_Click" ToolTip="添加 GitHub 前缀线路"/><Button Content="&#xE738;" Style="{StaticResource IconButtonStyle}" Margin="6,0,0,0" Click="RemoveProxy_Click" ToolTip="删除所选线路"/></StackPanel></Grid><DataGrid x:Name="GithubProxyGrid" Height="190" Margin="14,10,14,0" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="36" ColumnHeaderHeight="36" BeginningEdit="GithubProxyGrid_BeginningEdit"><DataGrid.Columns><DataGridTextColumn Header="地址" Width="*" Binding="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><DataGridComboBoxColumn Header="优先级" Width="92" ItemsSource="{StaticResource PriorityValues}" SelectedItemBinding="{Binding Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></DataGrid.Columns></DataGrid><TextBlock Margin="14,7,14,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Text="10 到 1 顺序尝试，0 表示禁用；直连不可删除。"/><Grid Margin="14,18,14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="HTTP 网络代理"/><TextBlock Text="可选，不支持账号密码" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel><TextBox x:Name="HttpProxyBox" Grid.Column="1" ToolTip="例如：http://127.0.0.1:7890"/></Grid><Border Height="1" Margin="0,22" Background="#D7DEE0"/><Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><CheckBox x:Name="AutoUpdateCheck" Content="启动后自动检查更新" Height="30"/><TextBlock x:Name="CurrentVersionText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/><TextBlock x:Name="UpdateStatusText" Text="尚未检查" Margin="0,4,20,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/></StackPanel><Button x:Name="CheckUpdateButton" Grid.Column="1" Content="检查更新" Style="{StaticResource SecondaryButtonStyle}" Width="96" Height="34" Click="CheckUpdatePage_Click"/></Grid></StackPanel></ScrollViewer><TextBlock x:Name="NetworkErrorText" Grid.Row="1" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="12"/></Grid>
                </Grid>
                <Border Grid.Row="1" Background="#90E8EEF0" BorderBrush="#D7DEE0" BorderThickness="0,1,0,0"><Grid Margin="30,0"><TextBlock x:Name="FooterStatusText" Text="就绪" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/><TextBlock x:Name="ListenerStatusText" Text="监听中" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
            </Grid>
        </Grid>
    </Border>
</Window>
