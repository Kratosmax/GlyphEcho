<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>GlyphEcho</AssemblyName>
    <RootNamespace>GlyphEcho</RootNamespace>
    <Version>0.3.1</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\GlyphEcho.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\GlyphEcho.png" />
    <Resource Include="Assets\GlyphEcho.png" />
    <Compile Remove="GlyphEcho.Updater\**\*.cs" />
    <Compile Remove="GlyphEcho.SmokeTests\**\*.cs" />
    <None Remove="GlyphEcho.Updater\**\*" />
    <None Remove="GlyphEcho.SmokeTests\**\*" />
  </ItemGroup>
</Project>
